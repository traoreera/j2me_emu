# Profil Raspberry Pi Zero 2 W (Pi OS Lite 64 bits). Usage :
#   set -a; . profiles/pi-zero2.env; set +a; ./j2me_emu games/xxx.jar
# Les variables déjà présentes dans l’environnement, y compris ce profil, priment
# sur les valeurs JME_* des .conf chargées par l’émulateur.
JME_HEAP=65536
JME_HEAP_MAX=131072
JME_FRAME_BUDGET=33
JME_WINDOW_WIDTH=800
JME_WINDOW_HEIGHT=480
JME_FULLSCREEN=1
JME_SCALE=integer
JME_RENDER_STATS=1
JME_AUDIO=sdl
